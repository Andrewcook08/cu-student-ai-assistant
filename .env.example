
# Database connections (Docker Compose internal networking)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/cu_assistant
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=development
REDIS_URL=redis://redis:6379/0

# Production-only secrets (required when running with docker-compose.prod.yml)
# Generate JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# POSTGRES_PASSWORD=   # replaces the dev default "postgres"
# NEO4J_PASSWORD=      # replaces the dev default "development"
# REDIS_PASSWORD=      # requirepass for Redis

# LLM (Anthropic API)
# Local dev: generate a key at https://console.anthropic.com/ and paste it below.
# Production: injected automatically from GCP Secret Manager at container start —
#             do NOT set this in production env files or Cloud Run env vars directly.
ANTHROPIC_API_KEY=blah
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Embeddings (Ollama — runs in Docker for vector search only)
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# CORS
CORS_ORIGINS=http://localhost:5173

# Docs (OpenAPI UI — set true for local dev, leave unset/false in production)
ENABLE_DOCS=true
