# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

project_id          = "your-gcp-project-id"
region              = "us-central1"
zone                = "us-central1-a"
vpc_connector_range = "10.8.0.0/28"
data_disk_size_gb   = 50

# ── Secret Manager prereqs ────────────────────────────────────────────────────
# Before running `terraform apply`, populate secret values so the VM startup
# script can fetch them. The secret shells are created by Terraform; only the
# values must be added manually (so passwords never enter Terraform state).
#
#   gcloud secrets versions add data-vm-postgres-password \
#     --data-file=<(openssl rand -hex 20)
#   gcloud secrets versions add data-vm-neo4j-password \
#     --data-file=<(openssl rand -hex 20)
#   gcloud secrets versions add data-vm-redis-password \
#     --data-file=<(openssl rand -hex 20)

# ── Developer access ──────────────────────────────────────────────────────────
# Google accounts that need IAP tunnel + OS Login access to the VM.
# Set in terraform.tfvars (gitignored) — do NOT commit real email addresses here.
#
# developer_accounts = [
#   "developer1@example.com",
#   "developer2@example.com",
# ]

# ── Alerting ──────────────────────────────────────────────────────────────────
# Cloud Monitoring notification channel resource names for VM down alerts.
# Create channels in the GCP console and paste the resource names here.
#
# alert_notification_channels = [
#   "projects/your-project/notificationChannels/123456789",
# ]

# ── Cloud Run secrets (DEPLOY-004 / CUAI-67) ─────────────────────────────────
# After `terraform apply` creates the secret shells, populate each value before
# the Cloud Run services will successfully boot. Values never enter Terraform state.
#
# Use the data VM internal IP 10.0.0.10 when constructing connection strings.
#
#   gcloud secrets versions add cloud-run-database-url \
#     --data-file=<(echo -n "postgresql+psycopg://postgres:STRONG_PW@10.0.0.10:5432/cu_assistant")
#
#   gcloud secrets versions add cloud-run-neo4j-password \
#     --data-file=<(echo -n "STRONG_NEO4J_PW")      # same value as data-vm-neo4j-password
#
#   gcloud secrets versions add cloud-run-redis-url \
#     --data-file=<(echo -n "redis://:STRONG_REDIS_PW@10.0.0.10:6379")
#
#   gcloud secrets versions add cloud-run-jwt-secret-key \
#     --data-file=<(openssl rand -hex 32)
#
#   # ANTHROPIC_API_KEY — Andrew populates this. Only chat-service-sa has secretAccessor.
#   # Team members should NOT be granted secretAccessor on this secret.
#   gcloud secrets versions add anthropic-api-key \
#     --data-file=<(echo -n "sk-ant-…")

# ── Cloud Run image tag ───────────────────────────────────────────────────────
# Override on manual deploys to pin a specific image SHA.
# CI sets this automatically via the deploy workflow.
#
# image_tag = "latest"

# ── Ollama embed service URL (CUAI-88 / DEPLOY-008) ──────────────────────────
# Optional override. By default Terraform reads the URL directly from the
# managed ollama-embed service in this module — no value needed here.
# Set only if pointing course-search-api / chat-service at an embed service in
# a different project, or debugging against a self-hosted endpoint.
#
# ollama_embed_url = "https://ollama-embed-HASH-uc.a.run.app"
